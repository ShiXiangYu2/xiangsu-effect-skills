{
  "version": 2,
  "skills": {
    "workflow": {
      "EffectWorkflow": {
        "title": "特效制作工作流",
        "status": "stable",
        "summary": "完整特效制作：方案确认 → 资产准备 → 场景搭建 → 脚本 → 验证",
        "triggers": ["复杂视觉目标", "完整效果", "多系统联动"],
        "dependencies": ["SceneEditing", "Prefab", "VFX", "MaterialAuthoring", "AssetBatchGeneration", "PreviewInteraction"],
        "anti_patterns": ["不要跳过方案直接铺场景", "不要用 add_scene_object 替代 add_builtin_object"],
        "priority": 10
      },
      "AssetWorkflow": {
        "title": "快速资产工作流",
        "status": "stable",
        "summary": "仅生成或轻量挂载资产，不扩展为完整效果",
        "triggers": ["只生成资产", "轻量挂载", "快速预览素材"],
        "dependencies": ["SceneEditing", "ImageGeneration", "AudioGeneration", "AssetBatchGeneration"],
        "anti_patterns": ["不要默认扩展成完整场景", "不要生成全屏背景替代局部承载"],
        "priority": 8
      },
      "QuickEditWorkflow": {
        "title": "快速编辑工作流",
        "status": "stable",
        "summary": "少数命令即可完成的局部修改和二次编辑",
        "triggers": ["改参数", "改名", "调整层级", "添加简单对象", "二次编辑"],
        "dependencies": ["SceneEditing"],
        "anti_patterns": ["不要为小改动重建整套结构", "不要用 add_scene_object + add_component 替代 add_builtin_object"],
        "priority": 9
      }
    },
