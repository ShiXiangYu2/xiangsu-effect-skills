# 复制为 .env 并填入你的密钥（此文件仅本地使用，不会被打包进公开专家包）

# ─────────────────────────────────────────────────────────
# 模式一【本地/作者开发机】：保留真 JEV（TypeSafe System One）
#   1) 设置环境变量 JEV_LOCAL=1（启用作者本地路径与默认代理）
#   2) TYPESAFE_API_KEY 从 D:\dishu\服务器\.env 自动读取（或下方覆盖）
#   3) JEV_PROXY 默认指向本地代理出口（绕过区域 451 拦截）
# ─────────────────────────────────────────────────────────
# 本地模式开关（公开用户请勿设置；作者本机设为 1）
JEV_LOCAL=1

# TypeSafe 密钥：默认自动读取 D:\dishu\服务器\.env；也可在此直接覆盖
# TYPESAFE_API_KEY=你的_typesafe_key

# JEV 区域受限时走本地代理绕过（改成你本机可访问允许区域的代理出口）
JEV_PROXY=http://127.0.0.1:7890

# opc.fiime.cn 统一模型网关密钥（文本/生图/生视频）
# 既用于 Tier2 推理降级，也用于素材/特效阶段的生图生视频
OPC_API_KEY=opc_sk_xxxx

# ─────────────────────────────────────────────────────────
# 模式二【公开版/其他用户】：无需任何私有密钥
#   不设置 JEV_LOCAL、不填 TYPESAFE_API_KEY 即可。
#   决策门自动降级：Tier1 真 JEV(需自带 key) → Tier2 推理模型(需 OPC_API_KEY)
#   → Tier3 主理人自行裁决（返回 agent_self 信号，编排层按 criteria 现场判断）。
#   若有自己的 TypeSafe 账号，填入下方 TYPESAFE_API_KEY 即启用真 JEV。
# ─────────────────────────────────────────────────────────
